@PACKAGE_INIT@
set(iiPhotoLibraryPresentationBridge_SPDX_LICENSE "Apache-2.0")
include(CMakeFindDependencyMacro)
find_dependency(iiPhotoLibrary CONFIG COMPONENTS Library HINTS "${CMAKE_CURRENT_LIST_DIR}/../iiPhotoLibrary")
find_dependency(iiPhotoLibraryPresentation CONFIG HINTS "${CMAKE_CURRENT_LIST_DIR}/../iiPhotoLibraryPresentation")
include("${CMAKE_CURRENT_LIST_DIR}/iiPhotoLibraryPresentationBridgeTargets.cmake")
check_required_components(iiPhotoLibraryPresentationBridge)
