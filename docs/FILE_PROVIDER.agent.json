    {
      "id": "b000010",
      "kind": "blank",
      "start_line": 17,
      "end_line": 17,
      "raw": "\n"
    },
    {
      "id": "b000011",
      "kind": "paragraph",
      "start_line": 18,
      "end_line": 19,
      "raw": "The `Albums` target stays independent of Qt and provider adapters. Only the\nlegacy photo/UI target imports Qt file-device adapters.\n"
    }
