  "blocks": [
    {
      "id": "b000001",
      "kind": "heading",
      "start_line": 1,
      "end_line": 1,
      "raw": "# Dependency components\n",
      "level": 1,
      "title": "Dependency components"
    },
    {
      "id": "b000002",
      "kind": "blank",
      "start_line": 2,
      "end_line": 2,
      "raw": "\n"
    },
    {
      "id": "b000003",
      "kind": "paragraph",
      "start_line": 3,
      "end_line": 5,
      "raw": "Albums is the existing Qt-free C++23 library. Its identifiers, album registry,\nsmart collections and provider-independent values do not depend on the legacy\nphoto controller.\n"
    },
    {
      "id": "b000004",
      "kind": "blank",
      "start_line": 6,
      "end_line": 6,
      "raw": "\n"
    },
    {
      "id": "b000005",
      "kind": "paragraph",
      "start_line": 7,
      "end_line": 11,
      "raw": "The legacy photo controller and native photo-library adapters still use Qt Core,\nGui and Concurrent. Clipboard/sharing actions now consume\n`iiSocietyContainer::Sharing` rather than the complete `Gui` target. Indexing,\noriginal transfer, and preview processing therefore no longer pull in the\ncontainer's Qt Quick image provider or application/window helpers.\n"
    },
    {
      "id": "b000006",
      "kind": "blank",
      "start_line": 12,
      "end_line": 12,
      "raw": "\n"
    },
    {
      "id": "b000007",
      "kind": "paragraph",
      "start_line": 13,
      "end_line": 15,
      "raw": "The public photo controller API, photo store format and native system sharing\nbehavior remain unchanged. This component split does not claim removal of the\nremaining Qt image-codec and event-loop adapters.\n"
    }
  ],
