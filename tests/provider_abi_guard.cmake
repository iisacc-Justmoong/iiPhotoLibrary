include("${PHOTO_SOURCE}/cmake/ProviderAbi.cmake")

set(expected "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
set(changed "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")
iiphoto_provider_abi_matches("${expected}" "${expected}" matches)
if(NOT matches)
    message(FATAL_ERROR "A matching FileDevice header must be accepted")
endif()
iiphoto_provider_abi_matches("${expected}" "${changed}" matches)
if(matches)
    message(FATAL_ERROR "A different FileDevice header must be rejected")
endif()
iiphoto_provider_abi_matches("" "${expected}" matches)
if(matches)
    message(FATAL_ERROR "A missing build fingerprint must be rejected")
endif()
iiphoto_provider_abi_matches("${expected}" "" matches)
if(matches)
    message(FATAL_ERROR "A missing consumer fingerprint must be rejected")
endif()
