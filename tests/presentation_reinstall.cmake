foreach(_attempt RANGE 1 2)
    set(_args --install "${BUILD_DIR}" --prefix "${REINSTALL_PREFIX}")
    if(BUILD_CONFIG)
        list(APPEND _args --config "${BUILD_CONFIG}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" ${_args}
        RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _error)
    if(NOT _result EQUAL 0 OR _error MATCHES "(^|\n)error:")
        message(FATAL_ERROR "Photo presentation install attempt ${_attempt} failed:\n${_output}\n${_error}")
    endif()
    if(_attempt EQUAL 1)
        get_filename_component(_name "${SOURCE_LIBRARY}" NAME)
        execute_process(COMMAND /usr/bin/touch -r "${SOURCE_LIBRARY}"
            "${REINSTALL_PREFIX}/${INSTALL_LIBDIR}/${_name}" RESULT_VARIABLE _touch)
        if(NOT _touch EQUAL 0)
            message(FATAL_ERROR "Could not prepare the repeat-install timestamp")
        endif()
    endif()
endforeach()
