string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(work "${PROJECT_BUILD}/albums-consumer-${nonce}")
file(MAKE_DIRECTORY "${work}")
function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        file(REMOVE_RECURSE "${work}")
        message(FATAL_ERROR "Command failed (${result}): ${ARGV}\n${output}\n${error}")
    endif()
    message(STATUS "${output}${error}")
endfunction()
set(stage "${work}/stage")
set(relocated "${work}/relocated")
file(REMOVE_RECURSE "${stage}" "${relocated}")
run("${CMAKE_COMMAND}" --install "${PROJECT_BUILD}" --prefix "${stage}")
file(RENAME "${stage}" "${relocated}")
file(READ "${relocated}/share/iiPhotoLibrary/LICENSE" installed_license)
if(NOT installed_license MATCHES "Apache License" OR NOT installed_license MATCHES "Version 2\\.0, January 2004")
    message(FATAL_ERROR "Installed LICENSE is not the Apache-2.0 text")
endif()
if(installed_license MATCHES "MIT License")
    message(FATAL_ERROR "Installed LICENSE still claims the MIT License")
endif()
file(READ "${relocated}/share/iiPhotoLibrary/NOTICE" installed_notice)
if(NOT installed_notice MATCHES "Copyright \\(c\\) 2026 iisacc")
    message(FATAL_ERROR "Installed NOTICE is missing Copyright (c) 2026 iisacc")
endif()
file(READ "${relocated}/lib/cmake/iiPhotoLibrary/iiPhotoLibraryConfig.cmake" installed_config)
if(NOT installed_config MATCHES "set\\(iiPhotoLibrary_SPDX_LICENSE \"Apache-2\\.0\"\\)")
    message(FATAL_ERROR "Installed package config does not export iiPhotoLibrary_SPDX_LICENSE")
endif()
file(READ "${relocated}/share/iiPhotoLibrary/licenses/nlohmann-json/LICENSE.MIT" installed_nlohmann)
if(NOT installed_nlohmann MATCHES "MIT License" OR NOT installed_nlohmann MATCHES "Niels Lohmann")
    message(FATAL_ERROR "Installed nlohmann/json license was not preserved")
endif()
run("${CMAKE_COMMAND}" --fresh -G "${GENERATOR}" -S "${PROJECT_SOURCE}/tests/albums_consumer" -B "${work}/build"
    "-DiiPhotoLibrary_DIR=${relocated}/lib/cmake/iiPhotoLibrary"
    -DCMAKE_DISABLE_FIND_PACKAGE_Qt6=TRUE -DCMAKE_DISABLE_FIND_PACKAGE_iiSocietyContainer=TRUE -DCMAKE_BUILD_TYPE=Release)
run("${CMAKE_COMMAND}" --build "${work}/build" --parallel 4)
file(READ "${work}/build/run-path.txt" executable)
run("${executable}")

file(REMOVE_RECURSE "${work}")
